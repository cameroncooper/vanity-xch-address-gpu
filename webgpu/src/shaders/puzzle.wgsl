fn shatree_atom_synthetic_pk(synthetic_pk: array<u32, 48>) -> array<u32, 32> {
  var input: array<u32, 80>;
  input[0] = 0x01u;
  for (var i = 0u; i < 48u; i++) {
    input[i + 1u] = synthetic_pk[i];
  }
  return sha256_bytes(&input, 49u);
}

fn shatree_pair(left: array<u32, 32>, right: array<u32, 32>) -> array<u32, 32> {
  var input: array<u32, 80>;
  input[0] = 0x02u;
  for (var i = 0u; i < 32u; i++) {
    input[i + 1u] = left[i];
    input[i + 33u] = right[i];
  }
  return sha256_bytes(&input, 65u);
}

fn standard_puzzle_hash_from_synthetic_pk(synthetic_pk: array<u32, 48>) -> array<u32, 32> {
  let pk_atom = shatree_atom_synthetic_pk(synthetic_pk);
  let quoted_arg = shatree_pair(Q_KW_TREEHASH, pk_atom);
  let one_nil = shatree_pair(ONE_TREEHASH, NIL_TREEHASH);
  let quoted_arg_and_rest = shatree_pair(quoted_arg, one_nil);
  let curried_values = shatree_pair(C_KW_TREEHASH, quoted_arg_and_rest);
  let curried_nil = shatree_pair(curried_values, NIL_TREEHASH);
  let mod_and_args = shatree_pair(QUOTED_MOD_HASH, curried_nil);
  return shatree_pair(A_KW_TREEHASH, mod_and_args);
}

fn synthetic_sk_from_wallet(wallet_pk: array<u32, 48>, wallet_sk: array<u32, 32>) -> array<u32, 32> {
  var offset_input: array<u32, 80>;
  for (var i = 0u; i < 48u; i++) {
    offset_input[i] = wallet_pk[i];
  }
  for (var i = 0u; i < 32u; i++) {
    offset_input[48u + i] = DEFAULT_HIDDEN_PUZZLE_HASH[i];
  }
  var offset = sha256_bytes(&offset_input, 80u);
  offset = reduce_signed_scalar_mod_order(offset);
  return add_scalars_mod_order(wallet_sk, offset);
}

fn synthetic_pk_from_wallet(wallet_pk: array<u32, 48>, wallet_sk: array<u32, 32>) -> array<u32, 48> {
  let synthetic_sk = synthetic_sk_from_wallet(wallet_pk, wallet_sk);
  let projective = fixed_base_mul_generator(synthetic_sk);
  let affine = projective_to_affine(projective);
  return compress_g1(affine);
}
